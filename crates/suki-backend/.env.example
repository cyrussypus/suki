# Copy to crates/suki-backend/.env and supply private local values. Never commit .env.
DATABASE_URL=mysql://suki:CHANGE_ME@127.0.0.1:3306/suki
# Use a separate database whose name ends in _test for integration tests.
TEST_DATABASE_URL=mysql://suki:CHANGE_ME@127.0.0.1:3306/suki_test
# Required server-only signing key. Generate once with: openssl rand -hex 32
SUKI_INTEGRITY_KEY=
# Required, independent AES-256-GCM key. Generate once: openssl rand -hex 32
DATA_ENCRYPTION_KEY=
BIND_ADDR=127.0.0.1:8080
APP_ORIGIN=http://localhost:8080
# false is accepted only for localhost development. Production must use true.
COOKIE_SECURE=false
RUST_LOG=suki_api=info,tower_http=info
# Comma-separated administrator emails; an empty list disables admin access.
ADMIN_EMAILS=
# Optional one-time administrator bootstrap, requires at least 16 password bytes.
# Remove both values after the first successful startup.
# BOOTSTRAP_ADMIN_EMAIL=operator@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# Backend-only key restricted to the Routes API and deployment egress identity.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_ROUTES_URL=https://routes.googleapis.com/directions/v2:computeRoutes
# Set an absolute, writable, persistent path for production vendor photos.
# SUKI_MEDIA_DIR=/var/lib/suki/vendor-images
# Temporary compatibility switch only. Omit to require the Bankerohan fee for new quotes.
# SUKI_ALLOW_LEGACY_QUOTES=false
# R2 storage for new product and avatar photos. Supply all five values to enable uploads.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_DOMAIN=https://media.example.com
# Optional loopback-only HTTP endpoint for S3 emulator testing; production uses the R2 endpoint.
# R2_ENDPOINT_URL=http://127.0.0.1:4200
